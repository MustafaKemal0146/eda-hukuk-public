# Compose değişkenleri (070 §16, 071 §3). Sır İÇERMEZ: sırlar EDA_SECRETS_DIR altındaki dosyalardadır.
EDA_ENV=beta-synthetic
NODE_ENV=production
COMPOSE_PROFILES=core,ai,docs,mcp,admin,av,backup
EDA_SECRETS_DIR=/run/eda-secrets
APP_DOMAIN=<beta-alan-adi>
APP_URL=https://app.<beta-alan-adi>
ADMIN_URL=https://admin.<beta-alan-adi>
MARKETING_URL=https://<beta-alan-adi>
ADMIN_ALLOWED_CIDRS=<wireguard-alt-agi>
ACME_EMAIL=<ops-eposta>
CADDY_TLS_MODE=acme
API_ADMIN_LISTEN_HOST=172.30.10.2
LOG_LEVEL=info
MOCK_LLM=false
EMBED_PROVIDER=tei
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBED_BATCH_URL=http://embed-query:8080
RERANK_ENABLED=false
CLAMAV_ENABLED=true
CLAMD_CONF=../clamav/clamd.beta.conf
EMAIL_TRANSPORT=http
EMAIL_API_URL=<eposta-saglayici-url>
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
EGRESS_LLM_ACL=../egress/egress-llm.sandbox.yaml
SEED_PROFILE=prod
PG_SIZE_CONF=../postgres/size/beta.conf
BACKUP_S3_HOST=<tr-offsite-s3>
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
