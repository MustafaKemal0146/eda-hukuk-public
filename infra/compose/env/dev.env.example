# Compose değişkenleri (070 §16, 071 §3). Sır İÇERMEZ: sırlar EDA_SECRETS_DIR altındaki dosyalardadır.
EDA_ENV=development
NODE_ENV=development
COMPOSE_PROFILES=core,admin,mcp
EDA_SECRETS_DIR=infra/secrets/dev
EDA_IMAGE_PREFIX=eda
EDA_TAG=dev
APP_DOMAIN=eda.localhost
APP_URL=https://app.eda.localhost:8443
ADMIN_URL=https://admin.eda.localhost:8443
MARKETING_URL=https://eda.localhost:8443
ADMIN_ALLOWED_CIDRS=private_ranges
CADDY_TLS_MODE=internal
API_ADMIN_LISTEN_HOST=0.0.0.0
LOG_LEVEL=debug
MOCK_LLM=true
DEV_REAL_LLM=
PLATFORM_AI_KEY_FALLBACK=false
EMBED_PROVIDER=mock
EMBED_BATCH_URL=http://embed-query:8080
RERANK_ENABLED=false
CLAMAV_ENABLED=false
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://mailpit:1025
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
EGRESS_LLM_ACL=../egress/egress-llm.sandbox.yaml
SEED_PROFILE=dev
PG_SIZE_CONF=../postgres/size/dev.conf
OTEL_EXPORTER_OTLP_ENDPOINT=
GLITCHTIP_DSN=
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
