# E.D.A. Hukuk kenar yapılandırması (070 §12, 014 §3.1, 002 §4, 061 §2.1).
# Sözdizimi caddy v2.11.7 + caddy-dns/cloudflare v0.2.4 ile `caddy adapt`/`caddy validate` edildi.
# CSP Caddy'de KONMAZ (nonce'lu CSP proxy.ts'de; (marketing) için hash tabanlı).
#
# Env: APP_DOMAIN, APP_URL, CADDY_TLS_MODE (acme | internal), ADMIN_ALLOWED_CIDRS (boşlukla
# ayrılmış CIDR; dev: private_ranges), ACME_EMAIL, ACME_DNS_PROVIDER, WEB_UPSTREAM, ADMIN_UPSTREAM.
# Dev: APP_DOMAIN=eda.localhost, konteynır içi 443, host 127.0.0.1:8443 -> 443.
{
	admin 127.0.0.1:2019 # yalnız loopback; yayınlanmaz (061 CTL-HDR-07)
	email {$ACME_EMAIL}
	grace_period 30s # açık SSE akışları nazikçe kapanır
	servers {
		protocols h1 h2 # HTTP/3 (UDP 443) MVP'de kapalı
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
			# write tanımsız: SSE akışları uzun sürer (061 CTL-HDR-06)
		}
		max_header_size 16KB
	}
	import tls/global-{$CADDY_TLS_MODE}.caddy # acme: boş; internal: auto_https disable_redirects
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=(), serial=(), bluetooth=(), midi=(), display-capture=(), browsing-topics=()"
		# Pencere yalıtımı: açılan/açan pencerelerle tarayıcı bağlamı paylaşılmaz; kaynaklar yalnız aynı origin'e verilir.
		# Uygulama bu üç başlığı yazmaz (yalnız CSP ve nosniff); burada tek yazım olduğundan çifte değer oluşmaz.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Tıklama tuzağı (clickjacking) koruması: sayfalar başka sitede çerçevelenemez.
		X-Frame-Options "DENY"
		# Content-Security-Policy BURADA TANIMLANMAZ: tam nonce'lu politika uygulamanın `proxy.ts` dosyasından gelir
		# (apps/web, apps/admin; `frame-ancestors 'none'` dahil). Caddy `header` ile (`?` öneki dahil) bu başlığı
		# koyarsa uygulamanın politikasını ezer ve canlıda yalnız `frame-ancestors` kalır (pilot güvenlik taraması).
		# Hata ve bakım sayfalarında çerçevelemeyi `X-Frame-Options` kapatır.
		-Server
		-X-Powered-By
		-Via # reverse_proxy'nin eklediği "1.1 Caddy" yazılım adını sızdırır
	}
}

# HTTP yöntem izin listesi: TRACE/TRACK/CONNECT ve beklenmeyen yöntemler 405 alır. `handle` blokları
# karşılıklı dışlayıcıdır; bu yüzden her sitede ilk (admin'de `@denied`dan sonraki) blok olarak alınır.
# rw: uygulama ve API (GET HEAD POST PUT PATCH DELETE OPTIONS); ro: yalnız sayfa sunan kök host.
(method_guard_rw) {
	@method_denied not method GET HEAD POST PUT PATCH DELETE OPTIONS
	handle @method_denied {
		header Allow "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
		respond "Yöntem desteklenmiyor." 405
	}
}

(method_guard_ro) {
	@method_denied not method GET HEAD OPTIONS
	handle @method_denied {
		header Allow "GET, HEAD, OPTIONS"
		respond "Yöntem desteklenmiyor." 405
	}
}

# RFC 9116 güvenlik iletişim dosyası (statik; uygulama route handler'ı yok). Expires yılda bir yenilenir
# (check-caddy.ts bitişe 30 günden az kalırsa uyarır).
(security_txt) {
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			Contact: mailto:destek@example.com
			Expires: 2027-10-17T00:00:00.000Z
			Preferred-Languages: tr, en
			Canonical: https://{$APP_DOMAIN}/.well-known/security.txt

			TXT 200
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow" # 061 CTL-HDR-02: app ve admin host'ları
}

# api/web durdurulduğunda (deploy.sh drenajı, 072 §9.2 adım 9) Caddy bakım yanıtı üretir.
# Hata yolunda site rotasının başlıkları uygulanmaz; güvenlik başlıkları burada yeniden eklenir.
(maintenance) {
	handle_errors {
		import security_headers
		@upstream_down expression {http.error.status_code} in [502, 503, 504]
		handle @upstream_down {
			header Retry-After "30"
			header Cache-Control "no-store"
			@api path /api/*
			handle @api {
				header Content-Type "application/json; charset=utf-8"
				respond `\{"error":\{"code":"INTERNAL_MAINTENANCE","message":"Bakım nedeniyle hizmet kısa süreliğine kullanılamıyor. Birkaç dakika sonra yeniden deneyin.","requestId":"{http.request.uuid}"\}\}` 503
			}
			handle {
				header Content-Type "text/plain; charset=utf-8"
				respond "Bakım nedeniyle hizmet kısa süreliğine kullanılamıyor. Birkaç dakika sonra yeniden deneyin." 503
			}
		}
	}
}

# Gövde sınırı: request_body yalnız upstream gövdeyi okurken devreye girer; upstream gövdeyi
# okumadan yanıt verirse 413 üretilmez. Bildirilen Content-Length sınırı aşıyorsa istek upstream'e
# gitmeden 413 ile kesilir; chunked gövdede request_body (MaxBytesReader) geçerlidir.
# Argüman: bayt (Caddy MB = 10^6 bayt; max_size ile aynı değer).
(body_limit) {
	@body_too_large expression `{http.request.header.Content-Length}.matches("^[0-9]{1,18}$") && int({http.request.header.Content-Length}) > {args[0]}`
	respond @body_too_large 413 {
		close
	}
}

# Erişim logu: sorgu dizesi, Cookie/Authorization/Set-Cookie ve tam istemci IP'si yazılmaz.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* "" # sorgu dizesi loga girmez
				request>headers>Referer regexp \?.* "" # yönlendiren URL'nin sorgusu da girmez
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# --- kök host: yalnız (marketing) ---
{$APP_DOMAIN} {
	import tls/{$CADDY_TLS_MODE}.caddy
	import security_headers
	import access_log
	import maintenance
	import method_guard_ro
	import security_txt
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			User-agent: *
			Disallow: /api/
			Disallow: /giris
			Disallow: /kayit

			TXT 200
	}
	redir /giris {$APP_URL}/giris 302 # tanıtım bağlantıları uygulama host'una yönlenir (053-ekranlar/12)
	redir /kayit {$APP_URL}/kayit 302
	@marketing path / /fiyatlandirma /guvenlik /kvkk-aydinlatma /kullanim-kosullari /gizlilik /cerez-politikasi /_next/static/* /sitemap.xml /favicon.ico
	handle @marketing {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
	handle {
		respond "Sayfa bulunamadı." 404 # /api* dahil diğer her yol
	}
}

# --- uygulama host'u ---
app.{$APP_DOMAIN} {
	import tls/{$CADDY_TLS_MODE}.caddy
	import security_headers
	import noindex
	import access_log
	import maintenance
	import method_guard_rw
	import security_txt
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			User-agent: *
			Disallow: /giris
			Disallow: /kayit
			Disallow: /sifre-sifirla
			Disallow: /davet/
			Disallow: /iki-adimli
			Disallow: /eposta-dogrulama
			Disallow: /api/

			TXT 200
	}
	@admin_api path /api/v1/admin /api/v1/admin/*
	handle @admin_api {
		respond 404 # admin API bu host'ta yoktur; varlık sızdırılmaz
	}
	@internal path /health /ready /metrics
	handle @internal {
		respond 404 # yalnız iç ağ
	}
	@large path /api/v1/files /api/v1/files/* /api/v1/documents/import /api/v1/kunye-checks /api/v1/kunye-checks/*
	handle @large {
		import body_limit 50000000
		request_body {
			max_size 50MB # upload.maxMb ile eşit
		}
		reverse_proxy api:8000 {
			flush_interval -1 # SSE tamponlanmaz
		}
	}
	handle /api/* {
		import body_limit 2000000
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}

# --- admin host'u: genel DNS'te yayınlanmaz, WireGuard iç DNS ---
admin.{$APP_DOMAIN} {
	import tls/{$CADDY_TLS_MODE}-dns.caddy # acme-dns: DNS-01; internal-dns: tls internal
	import security_headers
	import noindex
	import access_log
	import maintenance
	# `abort` varsayılan yönerge sırasında `handle`dan SONRA gelir; site düzeyinde `abort @denied`
	# yazılırsa izin dışı istek de handle bloklarına düşer ve yanıt alır (v2.11.7'de gözlendi).
	# Bu yüzden ret ilk handle bloğudur (handle blokları karşılıklı dışlayıcıdır).
	@denied not remote_ip {$ADMIN_ALLOWED_CIDRS} # prod: WireGuard alt ağı; dev: private_ranges
	handle @denied {
		abort # bağlantı kesilir (yanıt yok)
	}
	import method_guard_rw
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			User-agent: *
			Disallow: /

			TXT 200
	}
	handle /api/* {
		import body_limit 2000000
		request_body {
			max_size 2MB
		}
		reverse_proxy api-admin:8010 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy {$ADMIN_UPSTREAM:admin:3001}
	}
}
