    "body": "\r\n\r\n<!DOCTYPE html>\r\n\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head><title>\r\n\tUyuşmazlık Mahkemesi Karar Arama Uygulaması\r\n</title>\r\n    <style>\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        header {\r\n            background-color: #41403e;\r\n            color: white;\r\n            padding: 10px 0;\r\n            text-align: center;\r\n        }\r\n\r\n        .logo-container {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .logo {\r\n            height: 100px;\r\n            margin-right: 10px;\r\n        }\r\n\r\n        header h1 {\r\n            margin: 0;\r\n        }\r\n\r\n        nav ul {\r\n            list-style-type: none;\r\n            padding: 0;\r\n        }\r\n\r\n            nav ul li {\r\n                display: inline;\r\n                margin: 0 10px;\r\n            }\r\n\r\n                nav ul li a {\r\n                    color: white;\r\n                    text-decoration: none;\r\n                }\r\n\r\n        main {\r\n            padding: 20px;\r\n        }\r\n\r\n        #search-form {\r\n            margin-bottom: 20px;\r\n            text-align: center;\r\n        }\r\n\r\n            #search-form label {\r\n                margin-right: 10px;\r\n            }\r\n\r\n            #search-form input[type=\"text\"],\r\n            #search-form input[type=\"date\"] {\r\n                padding: 5px;\r\n                margin-right: 10px;\r\n            }\r\n\r\n            #search-form button {\r\n                padding: 5px 10px;\r\n                background-color: #dcc081;\r\n                color: white;\r\n                border: none;\r\n                cursor: pointer;\r\n            }\r\n\r\n                #search-form button:hover {\r\n                    background-color: #dcc081;\r\n                }\r\n\r\n        .altonce {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 30px;\r\n            height: 30px;\r\n        }\r\n\r\n        footer {\r\n            background-color: #333;\r\n            color: white;\r\n            text-align: center;\r\n            padding: 0px 0;\r\n            position: fixed;\r\n            width: 100%;\r\n            bottom: 0;\r\n        }\r\n\r\n        /*body {\r\n            font-family: Arial, sans-serif;\r\n            margin: 20px;\r\n        }*/\r\n\r\n        .container {\r\n            max-width: 1200px;\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .panel {\r\n            border: 1px solid #ddd;\r\n            padding: 15px;\r\n            margin-bottom: 20px;\r\n            border-radius: 5px;\r\n        }\r\n\r\n        /*.header {\r\n            background-color: #f5f5f5;\r\n            padding: 10px;\r\n            margin-bottom: 20px;\r\n            border-radius: 5px;\r\n            text-align: center;\r\n        }*/\r\n\r\n        .btn {\r\n            padding: 8px 15px;\r\n            background-color: #d9c080;\r\n            color: white;\r\n            border: none;\r\n            border-radius: 4px;\r\n            cursor: pointer;\r\n        }\r\n\r\n            .btn:hover {\r\n                background-color: #c7ac67;\r\n            }\r\n\r\n            .btn:disabled {\r\n                background-color: #ccc; /* Soluk gri renk */\r\n                color: #666;\r\n                cursor: not-allowed; /* \"Yasak\" imleci */\r\n            }\r\n\r\n        .search-container {\r\n            display: flex;\r\n            align-items: center;\r\n        }\r\n\r\n            .search-container .btn {\r\n                margin-left: 10px;\r\n                flex-shrink: 0;\r\n            }\r\n\r\n            .search-container .search-status-label {\r\n                margin-left: 15px;\r\n                font-size: 0.9em;\r\n            }\r\n\r\n        .search-box {\r\n            padding: 8px;\r\n            width: 300px;\r\n            border: 1px solid #ddd;\r\n            border-radius: 4px;\r\n        }\r\n\r\n        .grid-container {\r\n            margin-top: 20px;\r\n            overflow-x: auto;\r\n        }\r\n\r\n        .grid-view {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n\r\n            .grid-view th, .grid-view td {\r\n                border: 1px solid #ddd;\r\n                padding: 8px;\r\n                text-align: left;\r\n                width: 150px; /* Eşit genişlikte sütunlar */\r\n            }\r\n\r\n            .grid-view th {\r\n                background-color: #f2f2f2;\r\n            }\r\n\r\n                .grid-view th a {\r\n                    color: black;\r\n                    text-decoration: none;\r\n                }\r\n\r\n            .grid-view tr:nth-child(even) {\r\n                background-color: #f9f9f9;\r\n            }\r\n\r\n            .grid-view tr:hover {\r\n                background-color: #f1f1f1;\r\n            }\r\n\r\n        .grid-link {\r\n            color: #c7ac67;\r\n            text-decoration: none;\r\n            font-weight: bold;\r\n        }\r\n\r\n            .grid-link:hover {\r\n                text-decoration: underline;\r\n            }\r\n\r\n        .pagination {\r\n            display: flex;\r\n            justify-content: center;\r\n            margin-top: 20px;\r\n        }\r\n\r\n            .pagination a, .pagination span {\r\n                color: black;\r\n                float: left;\r\n                padding: 8px 16px;\r\n                text-decoration: none;\r\n                transition: background-color .3s;\r\n                border: 1px solid #ddd;\r\n                margin: 0 4px;\r\n            }\r\n\r\n                .pagination a:hover {\r\n                    background-color: #f1f1f1;\r\n                }\r\n\r\n            .pagination .active {\r\n                background-color: #4CAF50;\r\n                color: white;\r\n                border: 1px solid #4CAF50;\r\n            }\r\n        /* Basit ve modern sayfalama stili */\r\n        .simple-pager {\r\n            margin: 20px 0;\r\n            text-align: center;\r\n        }\r\n\r\n            .simple-pager a,\r\n            .simple-pager span {\r\n                display: inline-block;\r\n                /* Dikey padding 6px, yatay padding 16px olarak güncellendi */\r\n                padding: 6px 16px;\r\n                /* VEYA daha fazla isterseniz: padding: 6px 18px; */\r\n                margin: 0 3px;\r\n                border: 1px solid #ddd;\r\n                background-color: white;\r\n                color: #333;\r\n                text-decoration: none;\r\n                border-radius: 4px;\r\n            }\r\n\r\n                .simple-pager a:hover {\r\n                    background-color: #d9c080;\r\n                    color: white;\r\n                    border-color: #d9c080;\r\n                }\r\n\r\n            .simple-pager span {\r\n                background-color: #d9c080;\r\n                color: white;\r\n                border-color: #d9c080;\r\n                font-weight: bold;\r\n            }\r\n\r\n            .simple-pager table {\r\n                margin: 0 auto;\r\n                border-collapse: separate;\r\n                border-spacing: 3px;\r\n            }\r\n\r\n                .simple-pager table td {\r\n                    padding: 0;\r\n                    border: none;\r\n                }\r\n\r\n        /* Modal Arka Planı (Overlay) */\r\n        .modal {\r\n            display: none; /* Varsayılan olarak gizli */\r\n            position: fixed; /* Sayfa kaysa bile yerinde kalır */\r\n            z-index: 1000; /* Her şeyin önünde görünür */\r\n            left: 0;\r\n            top: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            overflow: auto; /* Gerekirse kaydırma çubuğu çıkar */\r\n            background-color: rgba(0, 0, 0, 0.6); /* Hafif karartılmış arka plan */\r\n            padding-top: 60px;\r\n        }\r\n\r\n        /* Modal İçerik Kutusu */\r\n        .modal-content {\r\n            background-color: #fefefe;\r\n            margin: 5% auto; /* Dikeyde ve yatayda ortalama */\r\n            padding: 25px 30px;\r\n            border: 1px solid #888;\r\n            width: 70%; /* Genişlik */\r\n            max-width: 800px; /* Maksimum genişlik */\r\n            border-radius: 8px;\r\n            box-shadow: 0 5px 15px rgba(0,0,0,0.3);\r\n            position: relative;\r\n            animation-name: animatetop;\r\n            animation-duration: 0.4s;\r\n        }\r\n\r\n        /* Açılma Animasyonu */\r\n        @keyframes animatetop {\r\n            from {\r\n                top: -300px;\r\n                opacity: 0;\r\n            }\r\n\r\n            to {\r\n                top: 0;\r\n                opacity: 1;\r\n            }\r\n        }\r\n\r\n        /* Kapatma Butonu (X) */\r\n        .close-button {\r\n            color: #aaa;\r\n            position: absolute;\r\n            top: 10px;\r\n            right: 20px;\r\n            font-size: 28px;\r\n            font-weight: bold;\r\n        }\r\n\r\n            .close-button:hover,\r\n            .close-button:focus {\r\n                color: black;\r\n                text-decoration: none;\r\n                cursor: pointer;\r\n            }\r\n\r\n        .modal-content h2 {\r\n            margin-top: 0;\r\n            color: #333;\r\n        }\r\n\r\n        .modal-content ul {\r\n            list-style-type: disc;\r\n            padding-left: 20px;\r\n        }\r\n\r\n        .modal-content li {\r\n            margin-bottom: 10px;\r\n        }\r\n\r\n        .search-container {\r\n            display: flex; /* Öğeleri yan yana dizer */\r\n            align-items: center; /* Öğeleri dikey olarak ortalar */\r\n        }\r\n\r\n            .search-container .btn {\r\n                margin-left: 10px; /* Arama kutusu ile buton arasına boşluk koyar */\r\n                flex-shrink: 0; /* Butonun ekran küçülünce ezilmesini engeller */\r\n            }\r\n\r\n            .search-container .search-status-label {\r\n                margin-left: 15px; /* Buton ile durum mesajı arasına boşluk koyar */\r\n                font-size: 0.9em; /* Durum mesajını biraz daha küçük yapar */\r\n            }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <header>\r\n        <div class=\"logo-container\">\r\n            <img src=\"logo.png\" alt=\"Logo\" class=\"logo\">\r\n            <h1>Uyuşmazlık Mahkemesi Kararları</h1>\r\n        </div>\r\n        <nav>\r\n            <ul>\r\n                <li><a href=\"https://www.uyusmazlik.gov.tr\">Anasayfa</a></li>\r\n                <li><a href=\"./Default\">Tüm Kararlar</a></li>\r\n                <li><a href=\"javascript:void(0);\" id=\"howToUseLink\">Nasıl Kullanılır?</a></li>\r\n            </ul>\r\n        </nav>\r\n    </header>\r\n    <main>\r\n        \r\n        <section id=\"content\">\r\n            <form method=\"post\" action=\"./\" id=\"form1\">\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\r\n<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"CA0B0334\" />\r\n<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n                <div class=\"container\">\r\n                    \r\n\r\n                    \r\n\r\n                    <div class=\"panel\">\r\n                        <h3>Karar İçeriğinde Ara</h3>\r\n\r\n                        <div class=\"search-container\">\r\n                            <input name=\"txtSearch\" type=\"text\" value=\"2026/206\" maxlength=\"255\" id=\"txtSearch\" class=\"search-box\" placeholder=\"Arama kelimesi...\" />\r\n                            \r\n                            <input type=\"submit\" name=\"btnSearch\" value=\"Ara\" onclick=\"handleSearchClick(this);\" id=\"btnSearch\" class=\"btn\" />\r\n\r\n                            <span id=\"lblSearchStatus\" class=\"search-status-label\"><font color=\"Blue\">Arama sonuçları: 1 dosya bulundu.</font></span>\r\n                        </div>\r\n                        <!-- SON: Yeni container -->\r\n\r\n                        <!-- Arama seçenekleri (Checkbox ve RadioButton) artık altta kalacak -->\r\n                        <div style=\"margin-top: 15px; margin-bottom: 15px;\">\r\n                            <input id=\"chkCaseSensitive\" type=\"checkbox\" name=\"chkCaseSensitive\" /><label for=\"chkCaseSensitive\">Büyük/küçük harfe duyarlı</label>\r\n                            <br />\r\n                            <br />\r\n                            <span id=\"rblSearchScope\"><input id=\"rblSearchScope_0\" type=\"radio\" name=\"rblSearchScope\" value=\"All\" /><label for=\"rblSearchScope_0\">Tüm İçerikte Ara</label><span style=\"margin-left: 15px;\"><input id=\"rblSearchScope_1\" type=\"radio\" name=\"rblSearchScope\" value=\"EsasNo\" checked=\"checked\" /><label for=\"rblSearchScope_1\">Esas Numarasına Göre Ara</label></span><span style=\"margin-left: 15px;\"><input id=\"rblSearchScope_2\" type=\"radio\" name=\"rblSearchScope\" value=\"KararNo\" /><label for=\"rblSearchScope_2\">Karar Numarasına Göre Ara</label></span></span>\r\n                        </div>\r\n\r\n                        \r\n                        <div style=\"margin-top: 15px;\">\r\n                            \r\n                            <span id=\"lblDeleteStatus\"></span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"grid-container\">\r\n                        \r\n                        <div>\r\n\t<table class=\"grid-view\" cellspacing=\"0\" rules=\"all\" border=\"1\" id=\"GridView1\">\r\n\t\t<tr>\r\n\t\t\t<th scope=\"col\"><a href=\"javascript:__doPostBack(&#39;GridView1&#39;,&#39;Sort$EsasNo&#39;)\">Esas Numarası</a></th><th scope=\"col\"><a href=\"javascript:__doPostBack(&#39;GridView1&#39;,&#39;Sort$KararNo&#39;)\">Karar Numarası</a></th><th scope=\"col\"><a href=\"javascript:__doPostBack(&#39;GridView1&#39;,&#39;Sort$KararTarihi&#39;)\">Karar Tarihi</a></th><th scope=\"col\">İşlemler</th>\r\n\t\t</tr><tr>\r\n\t\t\t<td>2026/206</td><td>2026/331</td><td>15/06/2026</td><td>\r\n                                        <a href='Uploads/2026-206.pdf' class=\"grid-link\" target=\"_blank\">Görüntüle</a>\r\n                                        |\r\n                <a href='Uploads/2026-206.pdf' download class=\"grid-link\">İndir</a>\r\n                                        \r\n                                    </td>\r\n\t\t</tr>\r\n\t</table>\r\n</div>\r\n                    </div>\r\n                </div>\r\n            </form>\r\n        </section>\r\n        <div class=\"altonce\">\r\n        </div>\r\n\r\n\r\n        <!-- ========== BAŞLANGIŞ: NASIL KULLANILIR POPUP HTML KODU ========== -->\r\n        <div id=\"howToUseModal\" class=\"modal\">\r\n            <div class=\"modal-content\">\r\n                <span class=\"close-button\">×</span>\r\n                <h2>Nasıl Kullanılır?</h2>\r\n                <p>Karar arama sistemini etkili bir şekilde kullanmak için aşağıdaki ipuçlarını izleyebilirsiniz:</p>\r\n\r\n                <h4>1. Temel Arama</h4>\r\n                <ul>\r\n                    <li><strong>Tek Kelime ile Arama:</strong> Arama kutusuna bir anahtar kelime yazıp \"Ara\" butonuna tıklayın.</li>\r\n                    <li><strong>Çoklu Kelime ile Arama:</strong> Birden fazla kelimenin **tümünün** geçtiği kararları bulmak için kelimeleri aralarına **virgül (,)** koyarak yazın. Örneğin: <code>Ankara, Rüzgar Enerjisi</code></li>\r\n                </ul>\r\n\r\n                <h4>2. Gelişmiş Arama Seçenekleri</h4>\r\n                <ul>\r\n                    <li><strong>Büyük/Küçük Harfe Duyarlı:</strong> Bu kutucuğu işaretlerseniz, arama sadece yazdığınız kelimeyle birebir (büyük/küçük harf eşleşmesiyle) aynı olan sonuçları getirir. Bu arama türü diğerine göre biraz daha yavaş çalışabilir.</li>\r\n                    <li><strong>Arama Kapsamı:</strong>\r\n                        <ul>\r\n                            <li><strong>Tüm İçerikte Ara:</strong> Girdiğiniz kelimeleri kararların tüm metninde, esas numarasında ve karar numarasında arar.</li>\r\n                            <li><strong>Esas Numarasına Göre Ara:</strong> Sadece esas numarası alanında arama yapar.</li>\r\n                            <li><strong>Karar Numarasına Göre Ara:</strong> Sadece karar numarası alanında arama yapar.</li>\r\n                        </ul>\r\n                    </li>\r\n                </ul>\r\n\r\n                <h4>3. Sonuçları Yönetme</h4>\r\n                <ul>\r\n                    <li><strong>Sıralama:</strong> Sonuçları Esas No, Karar No gibi sütun başlıklarına tıklayarak artan veya azalan şekilde sıralayabilirsiniz.</li>\r\n                    <li><strong>Görüntüle/İndir:</strong> Listelenen bir kararı yeni bir sekmede açmak için \"Görüntüle\", bilgisayarınıza kaydetmek için \"İndir\" linkini kullanın.</li>\r\n                </ul>\r\n\r\n                \r\n            </div>\r\n        </div>\r\n        <!-- ========== SON: NASIL KULLANILIR POPUP HTML KODU ========== -->\r\n        <!-- ========== BAŞLANGIÇ: POPUP JAVASCRIPT KODU ========== -->\r\n        <script type=\"text/javascript\">\r\n            // Gerekli HTML elementlerini seç\r\n            var modal = document.getElementById(\"howToUseModal\");\r\n            var link = document.getElementById(\"howToUseLink\");\r\n            var closeBtn = document.getElementsByClassName(\"close-button\")[0];\r\n\r\n            // \"Nasıl Kullanılır?\" linkine tıklandığında modalı göster\r\n            link.onclick = function () {\r\n                modal.style.display = \"block\";\r\n            }\r\n\r\n            // Kapatma butonuna tıklandığında modalı gizle\r\n            closeBtn.onclick = function () {\r\n                modal.style.display = \"none\";\r\n            }\r\n\r\n            // Kullanıcı modalın dışındaki gri alana tıklarsa modalı gizle\r\n            window.onclick = function (event) {\r\n                if (event.target == modal) {\r\n                    modal.style.display = \"none\";\r\n                }\r\n            }\r\n        </script>\r\n        <!-- ========== SON: POPUP JAVASCRIPT KODU ========== -->\r\n        <!-- ========== BAŞLANGIÇ: \"ARA\" BUTONU İÇİN YENİ VE BASİT JAVASCRIPT KODU ========== -->\r\n        <script type=\"text/javascript\">\r\n            function handleSearchClick(button) {\r\n                // Arama kutusunun boş olup olmadığını kontrol et\r\n                var searchBox = document.getElementById('txtSearch');\r\n                if (searchBox.value.trim() === '') {\r\n                    // Arama kutusu boşsa postback'i engelle\r\n                    return false;\r\n                }\r\n\r\n\r\n                if (button.disabled) {\r\n                    return false;\r\n                }\r\n\r\n\r\n                setTimeout(function () {\r\n                    button.disabled = true;\r\n                    button.value = 'Aranıyor...';\r\n                }, 1);\r\n\r\n                return true;\r\n            }\r\n        </script>\r\n        <!-- ========== SON: YENİ JAVASCRIPT KODU ========== -->\r\n    </main>\r\n\r\n    <footer>\r\n        <p>Uyuşmazlık Mahkemesi Bilgi İşlem Bürosu &copy; 2025</p>\r\n    </footer>\r\n\r\n\r\n\r\n</body>\r\n</html>\r\n"
  }
}
