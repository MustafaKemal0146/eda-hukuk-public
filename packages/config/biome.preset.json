{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!**/*.generated.json",
      "!**/*.generated.ts",
      "!**/tools.lock.json",
      "!**/.next",
      "!**/dist",
      "!**/node_modules",
      "!plans",
      "!services/doc-engine",
      "!**/*.md",
      "!pnpm-lock.yaml",
      "!!**/.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tiptap-pro/extension-ai": "TipTap Pro lisanslı paket yasak (013 §22.2)."
            }
          }
        }
      },
      "performance": {
        "noReExportAll": "error"
      },
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": false
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["infra/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/*/src/config/**",
        "services/*/src/config/**",
        "packages/db/src/config/**",
        "**/*.config.ts",
        "packages/config/vitest/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/**", "services/**", "!apps/api/src/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tiptap-pro/extension-ai": "TipTap Pro lisanslı paket yasak (013 §22.2).",
                  "pg": "Ham pg sürücüsü yalnız @eda/db içinde (031 §4.5, Y-98); withTenant kullanın.",
                  "drizzle-orm/node-postgres": "Ham Drizzle sürücüsü yalnız @eda/db içinde (031 §4.5); withTenant kullanın.",
                  "postgres": "postgres sürücüsü kullanılmaz; DB erişimi yalnız @eda/db sarmalayıcılarıyla (031 §4.5)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "apps/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tiptap-pro/extension-ai": "TipTap Pro lisanslı paket yasak (013 §22.2).",
                  "pg": "Ham pg sürücüsü yalnız @eda/db içinde (031 §4.5, Y-98); withTenant kullanın.",
                  "drizzle-orm/node-postgres": "Ham Drizzle sürücüsü yalnız @eda/db içinde (031 §4.5); withTenant kullanın.",
                  "postgres": "postgres sürücüsü kullanılmaz; DB erişimi yalnız @eda/db sarmalayıcılarıyla (031 §4.5).",
                  "@eda/db": "web/admin veritabanına erişemez (002 §8).",
                  "@eda/ai": "web/admin LLM geçidine erişemez (002 §8)."
                }
              }
            }
          },
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**", "packages/api-client/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
